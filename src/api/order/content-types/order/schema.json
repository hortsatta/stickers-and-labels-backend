{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "orderDate": {
      "type": "datetime",
      "required": true
    },
    "totalPrice": {
      "type": "decimal",
      "required": true
    },
    "shippingFee": {
      "type": "decimal",
      "default": 0
    },
    "discountPercent": {
      "type": "decimal",
      "default": 0,
      "max": 100
    },
    "orderNo": {
      "type": "string",
      "unique": true,
      "required": true,
      "maxLength": 64
    },
    "trackingNo": {
      "type": "string",
      "maxLength": 64
    },
    "shippingAddress": {
      "type": "component",
      "repeatable": false,
      "component": "info.address"
    },
    "orderItems": {
      "type": "component",
      "repeatable": true,
      "component": "shop.cart"
    },
    "account": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::account.account",
      "inversedBy": "order"
    },
    "shipping": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::shipping.shipping"
    }
  }
}
